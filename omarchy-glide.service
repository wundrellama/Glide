[Unit]
Description=Omarchy Glide mouse and keyboard sharing
Documentation=https://github.com/feschber/lan-mouse
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStartPre=/usr/bin/python3 %h/.config/omarchy/plugins/wundrellama.glide/scripts/glide_clipboard.py reconcile
# No idle or sleep inhibitor: emulated remote input already counts as user
# activity on the receiver, and an unused machine must still lock and suspend.
ExecStart=%h/.local/bin/omarchy-glide-engine daemon
Restart=on-failure
RestartSec=3
# Off the home LAN the bind address is missing and the engine exits at once
# (EADDRNOTAVAIL). Back off to one attempt a minute instead of looping every 3s.
RestartSteps=6
RestartMaxDelaySec=60
UMask=0077

[Install]
WantedBy=graphical-session.target
